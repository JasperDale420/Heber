<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.empire.heber.docker-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jacobmcmillan/Empire/Heber/scripts/heber_docker_watchdog.sh</string>
    </array>
    <!-- Reconcile every 2 min: restart any Heber app container left stopped
         (restart:always only covers crashes, not a stopped container). -->
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/jacobmcmillan/Empire/Heber</string>
    <key>StandardOutPath</key>
    <string>/Users/jacobmcmillan/Empire/Heber/logs/native/docker-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacobmcmillan/Empire/Heber/logs/native/docker-watchdog.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
