# Environment Configuration
# Copy to .env and fill in values

# External Volume (where all data is stored)
HEBER_DATA_ROOT=/Volumes/heber/data
HEBER_VOLUME_ROOT=/Volumes/HeberDocker

# Postgres (Catalog DB)
POSTGRES_USER=heber
POSTGRES_PASSWORD=heber_dev_password
POSTGRES_DB=heber_catalog
HEBER_POSTGRES_URL=postgresql+asyncpg://heber:heber_dev_password@localhost:5433/heber_catalog

# Redis (Event Bus)
HEBER_REDIS_URL=redis://localhost:6380
HEBER_REDIS_STREAM_NAME=heber:events
HEBER_REDIS_CONSUMER_GROUP=heber-writers
HEBER_REDIS_DLQ_STREAM_NAME=heber:events:dlq
HEBER_REDIS_CLAIM_IDLE_MS=60000
HEBER_REDIS_CLAIM_BATCH_SIZE=100
HEBER_REDIS_PROCESS_MAX_RETRIES=3
HEBER_REDIS_RETRY_BACKOFF_SECONDS=0.25

# Exact-match dedupe backing store (verifies Bloom hits against Redis).
# Kept OFF: benchmarked on the live event bus, a synchronous Redis SET per
# event adds ~2-6 ms/event and even a pipelined batch register degrades to
# ~0.4 ms/event under load — both far over the 5% throughput gate. See
# scripts/debug/bench_dedupe_store.py and heber/config.py for the numbers.
# HEBER_DEDUPE_REDIS_ENABLED=false
# HEBER_DEDUPE_REDIS_TTL_SECONDS=7200

# ClickHouse (Hot Store)
HEBER_CLICKHOUSE_HOST=clickhouse
HEBER_CLICKHOUSE_PORT=9000
HEBER_CLICKHOUSE_USER=default
HEBER_CLICKHOUSE_PASSWORD=
HEBER_CLICKHOUSE_DATABASE=heber

# Catalog API
HEBER_API_HOST=0.0.0.0
HEBER_API_PORT=8080
HEBER_CATALOG_URL=http://localhost:8085/api/v1

# LLM (OpenAI-compatible)
# - OpenAI: set HEBER_LLM_PROVIDER=openai and OPENAI_API_KEY
# - Qwen 2.5: set HEBER_LLM_PROVIDER=qwen and DASHSCOPE_API_KEY
HEBER_LLM_PROVIDER=openai
HEBER_LLM_MODEL=gpt-4o-mini
HEBER_LLM_BASE_URL=
HEBER_LLM_QWEN_REGION=intl
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Watch Service
DATA_GATEWAY_URL=http://localhost:8000
HEBER_WATCH_GATEWAY_API_KEY=gw_orion_trading_key_55555
HEBER_GOLD_PATH=/Volumes/heber/data/gold

# Dataflow Health Verification
HEBER_HEALTH_CONSUMER_METRICS_URL=http://localhost:9090/metrics
HEBER_HEALTH_WATCH_METRICS_URL=http://localhost:9091/metrics
HEBER_HEALTH_FRESHNESS_SECONDS=900
HEBER_HEALTH_REPORT_DIR=/data/ops/dataflow-health
HEBER_HEALTH_INTERVAL_SECONDS=300

# Feature Store (Feast)
HEBER_FEAST_REPO_PATH=/app/features

# Soda Core (Data Quality)
SODA_CHECKS_DIR=soda/checks
HEBER_SILVER_PATH=/Volumes/heber/silver


# OpenMetadata (Phase 5 - Catalog)
OPENMETADATA_HOST=http://localhost:8585
OPENMETADATA_API_KEY=your-openmetadata-jwt-token

# =============================================================================
# Tuning & Operations
# =============================================================================

# Hot Loader (ClickHouse writer)
HEBER_HOTLOADER_DATASETS=quotes,trades,bars
# HEBER_HOTLOADER_SILVER_BASE_PATH=/Volumes/heber/silver

# Service Identity
HEBER_SERVICE_NAME=heber
HEBER_SERVICE_VERSION=0.1.0
HEBER_INSTANCE_ID=unknown

# Bronze Writer Tuning
# HEBER_BRONZE_FLUSH_INTERVAL_SECONDS=30
# HEBER_BRONZE_MAX_BATCH_SIZE=10000

# Silver Writer Tuning
# HEBER_SILVER_TARGET_FILE_SIZE_MB=256
# HEBER_SILVER_MAX_ROWS_PER_FILE=1000000
# HEBER_SILVER_MAX_FLUSH_TIME_SECONDS=30
# HEBER_SILVER_ROW_GROUP_SIZE_MB=128

# Observability
# HEBER_METRICS_PORT=9090
# HEBER_OTEL_ENDPOINT=http://localhost:4317

# Quarantine
HEBER_QUARANTINE_PATH=quarantine
